# AIDis behind Caddy (written by deploy/setup.sh from deploy/templates/Caddyfile; edits are
# overwritten when setup.sh runs again). Caddy gets and renews the Let's Encrypt certificates.
{
	email __EMAIL__
}

__DOMAIN__ {
	encode zstd gzip

	# API, realtime (Socket.IO over WebSocket) and health checks -> the AIDis backend.
	@backend path /api/* /socket.io/* /health /ready
	handle @backend {
		reverse_proxy 127.0.0.1:__BACKEND_PORT__ {
			flush_interval -1
		}
	}

	# Everything else: the web client (a single-page app).
	handle {
		root * /srv/web
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
# voice-begin

# Voice (LiveKit signaling over WebSocket).
rtc.__DOMAIN__ {
	reverse_proxy 127.0.0.1:__LIVEKIT_PORT__
}
# voice-end
