{
  "name": "aidis-server",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "AIDis: private self-hosted communication server (text chat, presence, LiveKit voice) for a small group of friends.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "prisma migrate deploy && node dist/cli/seed.js && node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node dist/cli/seed.js",
    "user:create": "node dist/cli/users.js create",
    "user:list": "node dist/cli/users.js list",
    "user:disable": "node dist/cli/users.js disable",
    "user:enable": "node dist/cli/users.js enable",
    "user:password": "node dist/cli/users.js password",
    "user:role": "node dist/cli/users.js role",
    "user:sessions": "node dist/cli/users.js sessions",
    "user:revoke-sessions": "node dist/cli/users.js revoke-sessions"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "livekit-server-sdk": "2.19.1",
    "music-metadata": "^12.3.5",
    "nodemailer": "^10.3.1",
    "prisma": "7.10.0",
    "socket.io": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "@types/nodemailer": "^8.0.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "pglite-prisma-adapter": "0.7.2",
    "pino-pretty": "13.2.0",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
