# =============================================================================
# AIDis server configuration. deploy/setup.sh writes a ready .env from this file (random
# secrets, your domain, free ports); this file documents every setting. By hand: cp .env.example .env
# =============================================================================
# - .env holds secrets: never commit it, keep it chmod 600.
# - Every value marked CHANGE_ME must be replaced before the first start.
# - Every HOST PORT below is only a suggestion. Check it is free on the server
#   first (sudo ss -tulpn) and pick another number if it is taken.
#   Never stop an existing service to free a port.
# - Generate secrets with:  openssl rand -hex 32
# =============================================================================

# Docker Compose project name: prefixes containers, volumes and networks
# (aidis-backend-1, aidis_pgdata, ...). Keep it unique on the host.
COMPOSE_PROJECT_NAME=aidis

# -----------------------------------------------------------------------------
# Public address
# -----------------------------------------------------------------------------
# The origin clients use. No trailing slash.
PUBLIC_BASE_URL=https://chat.example.com
# Comma-separated list of browser origins allowed by CORS. Never "*" in production.
# The desktop app talks to the server through its own bridge and needs no entry here.
CORS_ORIGINS=https://chat.example.com

# -----------------------------------------------------------------------------
# Backend HTTP port on the HOST (container always listens on 3000)
# -----------------------------------------------------------------------------
# 127.0.0.1 = only the host Nginx can reach it. Do not change to 0.0.0.0.
BACKEND_HOST_BIND=127.0.0.1
# Suggested value; CHECK it is free first.
BACKEND_HOST_PORT=18080
# Which proxies may set X-Forwarded-For. Docker forwards localhost traffic from a
# private bridge address, so "loopback,uniquelocal" is correct with the bind above.
TRUST_PROXY=loopback,uniquelocal

LOG_LEVEL=info

# -----------------------------------------------------------------------------
# PostgreSQL (internal Docker network only, never published)
# -----------------------------------------------------------------------------
POSTGRES_USER=aidis
# Use hex (openssl rand -hex 32): it is embedded in a URL, so avoid @ : / ? # characters.
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32
POSTGRES_DB=aidis

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# At least 32 characters. openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
# Access token lifetime (s, m, h, d). Short on purpose.
ACCESS_TOKEN_TTL=15m
# Refresh token / device session lifetime; extended on every refresh.
REFRESH_TOKEN_TTL=30d
# Max login attempts per IP per minute (per-username lockout is built in as well).
LOGIN_RATE_LIMIT_MAX=10
# Max API requests per IP per minute.
RATE_LIMIT_MAX=300

# -----------------------------------------------------------------------------
# LiveKit (voice / video / screen sharing)
# -----------------------------------------------------------------------------
# Public signaling URL returned to clients: a dedicated subdomain served by the SAME
# host Nginx on 443 (hostname/SNI routing), proxied at "/" to LIVEKIT_HOST_PORT below.
# Needs its own DNS A record and certificate (docs/en/install.md, "DNS").
LIVEKIT_URL=wss://rtc.chat.example.com
# API key: any short identifier (letters/digits), e.g. openssl rand -hex 8
LIVEKIT_API_KEY=CHANGE_ME_key
# API secret: at least 32 characters. openssl rand -hex 32. Never given to clients.
LIVEKIT_API_SECRET=CHANGE_ME_openssl_rand_hex_32
# Lifetime of a voice join token (only needed to join; calls can last longer).
LIVEKIT_TOKEN_TTL=10m
LIVEKIT_LOG_LEVEL=info
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.7

# Signaling port on the HOST (localhost-only; container port is 7880). CHECK it is free.
LIVEKIT_HOST_BIND=127.0.0.1
LIVEKIT_HOST_PORT=17880

# --- Public media ports (router forwarding + firewall needed) -----------------
# WebRTC requires the SAME number on host and container; these values are used for
# both. CHECK each one is free on the host (UDP and TCP respectively).
# ICE over TCP fallback (TCP):
LIVEKIT_RTC_TCP_PORT=17881
# UDP media range. ~100 ports is plenty for ~10 people talking at once; widen it for more.
LIVEKIT_RTC_PORT_START=50000
LIVEKIT_RTC_PORT_END=50100
# Embedded TURN server over UDP (TURN/UDP fallback):
TURN_UDP_HOST_PORT=13478

# Public IP discovery. true = ask a STUN server (fine for a home connection).
LIVEKIT_USE_EXTERNAL_IP=true
# Optional: force the advertised public IP instead (e.g. if STUN detection is wrong).
LIVEKIT_NODE_IP=

# TURN domain: the hostname LiveKit hands to clients for TURN. It only has to resolve
# to this server's public IP. TURN/UDP needs no certificate, so the main domain is fine.
# (It would only become the TLS certificate name if TURN/TLS is enabled later.)
LIVEKIT_TURN_DOMAIN=chat.example.com
# Internal-only port range TURN uses to talk to the SFU inside the container.
# NOT published, NOT forwarded.
TURN_RELAY_PORT_START=30000
TURN_RELAY_PORT_END=30100
# TURN over TLS is off (0). It cannot share TCP 443 with the web server.
TURN_TLS_HOST_PORT=0


# -----------------------------------------------------------------------------
# Uploads / messages
# -----------------------------------------------------------------------------
# Max upload size in bytes (52428800 = 50 MiB). Keep Nginx client_max_body_size >= this.
MAX_UPLOAD_SIZE=52428800
# 0.5.5: resumable uploads (sent in 8 MiB pieces, so Nginx needs no change). 5368709120 = 5 GiB.
# The server refuses a file when the disk would keep less than 1 GiB free.
MAX_LARGE_UPLOAD_SIZE=5368709120
# Max characters per chat message.
MAX_MESSAGE_LENGTH=4000

# -----------------------------------------------------------------------------
# Link previews and GIFs (0.3.1)
# -----------------------------------------------------------------------------
# Preview cards for the first link of a message (YouTube, Steam, Open Graph pages). Fetched by the
# server (SSRF-protected: public addresses only, ports 80/443, size/time limits), cached 6 h.
LINK_PREVIEWS=true
# Steam store country / language for game cards (price only when Steam returns one).
# Game covers from the Steam store for activity cards and the game tracker. Off = no requests to Steam.
STEAM_ART=false
LINK_PREVIEW_STEAM_COUNTRY=us
LINK_PREVIEW_STEAM_LANGUAGE=english
# Server-backed GIF search: giphy | tenor | none. The key stays on the server; the provider only sees the query.
#   GIPHY:  https://developers.giphy.com/dashboard/
#   Tenor:  Google Cloud console (Tenor API v2)
# An unknown value or an empty key disables server GIFs with an error in the log; the server keeps running.
GIF_PROVIDER=none
GIF_API_KEY=
GIF_LOCALE=en_US

# -----------------------------------------------------------------------------
# Local development only (npm run dev on a developer machine, NOT used by Docker)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://aidis:devpassword@127.0.0.1:5432/aidis?schema=public
# NODE_ENV=development
# PORT=3000
# UPLOAD_DIRECTORY=./storage/uploads

# Optional local-only voice transcription; see voice-worker/README.md.
# No model downloads or external audio endpoint at runtime. Empty paths keep audio playback.
# Native backend paths (Docker uses docker-compose.voice.yml instead):
# VOICE_TRANSCRIBE_PYTHON=/absolute/path/to/local/python
# VOICE_TRANSCRIBE_SCRIPT=/absolute/path/to/voice-worker/worker.py
# VOICE_TRANSCRIBE_MODEL=/absolute/path/to/existing/small-multilingual-model
# Optional Docker overlay requires an existing, readable local model directory:
# VOICE_MODEL_DIRECTORY=/absolute/host/path/to/existing/small-multilingual-model

# Extra voice servers (LiveKit on another VPS) must be wss://<name>.VOICE_NODE_DOMAIN.
# Empty = the host name of PUBLIC_BASE_URL (e.g. wss://voice2.chat.example.com).
# VOICE_NODE_DOMAIN=
