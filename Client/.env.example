# AIDis web client configuration (only needed for development builds).
# EVERY VITE_* VALUE IS PUBLIC: it is compiled into the JavaScript that every browser downloads.
# Never put server secrets (JWT secret, LiveKit API key/secret, database passwords) here.

# Backend origin. Leave EMPTY for builds served from the same domain as the API (the normal
# installation: https://chat.example.com serves the client, /api/ and /socket.io/).
# The desktop app sets the server the user picked at runtime and ignores this.
VITE_API_URL=

# LiveKit signaling URL. The backend returns the URL with every voice token; this is only a fallback.
VITE_LIVEKIT_URL=

VITE_APP_NAME=AIDis

# Client-side limits mirroring the server defaults (MAX_MESSAGE_LENGTH, MAX_UPLOAD_SIZE).
# The server enforces the real limits; these only give earlier, friendlier feedback.
VITE_MAX_MESSAGE_LENGTH=4000
VITE_MAX_UPLOAD_MB=50

# ---- development only (read by vite.config.ts, not shipped to the browser) ----
# Where `npm run dev` proxies /api, /socket.io, /health and /ready.
DEV_PROXY_TARGET=http://localhost:3000
